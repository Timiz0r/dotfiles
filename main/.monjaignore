/*
!/*/
!/*.sh

# ignore files are used to keep stuff from getting to the repo from local, and to prevent local from being cleaned
/dev/
/obsidian/
/OneDrive/
/Dropbox/
/Unity/
/go/
/isos/
/vhds/
/FiraxisLive/
/steamvr/
/snap/
/icons/
/dumpanalysis/

/.*
!/.config/
!/.claude/
# gitignore semantics: a negation cannot re-include a file whose parent
# directory is excluded, so /.* has to be walked back one level at a time.
!/.local/
/.local/*
!/.local/share/
/.local/share/*
!/.local/share/icons/
/.local/share/icons/*
!/.local/share/icons/breeze-dark-yaru/
# it's recommended to put this in sets, since certain machines may have a different set
!**/.monjaignore

/Desktop/
/Documents/
/Downloads/
/Music/
/Pictures/
/Public/
/Videos/
